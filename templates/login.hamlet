$newline never
$# Self-contained on purpose: unauthenticated visitors cannot load /static, and
$# nothing here should name the app (see docs/login-page-plan.md).
\<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>Sign in
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background: #0f1117; color: #e2e4ed; min-height: 100vh;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 14px; line-height: 1.5;
        display: flex; align-items: center; justify-content: center; padding: 16px;
      }
      form {
        width: 100%; max-width: 320px; padding: 24px;
        background: #1a1d27; border: 1px solid #2a2d3a; border-radius: 10px;
        display: flex; flex-direction: column; gap: 12px;
      }
      h1 { font-size: 16px; font-weight: 700; }
      input {
        padding: 8px 12px; border: 1px solid #2a2d3a; border-radius: 6px;
        background: #0f1117; color: #e2e4ed; font-size: 13px; outline: none;
      }
      input:focus { border-color: #6366f1; }
      .error { color: #ef4444; font-size: 12px; }
      button {
        padding: 8px 16px; border: 1px solid #6366f1; border-radius: 6px;
        background: #6366f1; color: #fff; font-size: 13px; cursor: pointer;
      }
      button:hover { opacity: 0.85; }
  <body>
    <form method="post" action="@{LoginR}">
      <h1>Sign in
      <input type="hidden" name="#{defaultCsrfParamName}" value="#{token}">
      <input type="password" name="password" placeholder="Password" autocomplete="current-password" required autofocus>
      $maybe err <- merror
        <p .error>#{err}
      <button type="submit">Sign in
